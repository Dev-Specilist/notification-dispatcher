{
  "name": "notification-dispatcher",
  "version": "1.0.0",
  "description": "Bulk notification dispatcher (api + worker)",
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" --ignore \"**/*.int-spec.ts\"",
    "build:watch": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" --ignore \"**/*.int-spec.ts\" --watch",
    "dev:api": "concurrently -k -n swc,api \"pnpm build:watch\" \"node --watch-path=dist --enable-source-maps dist/main.js\"",
    "dev:worker": "concurrently -k -n swc,worker \"pnpm build:watch\" \"node --watch-path=dist --enable-source-maps dist/worker.js\"",
    "start:api": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "format:check": "prettier --check src test",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepare": "husky"
  },
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pactum": "^3.9.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@parcel/watcher"
    ]
  },
  "lint-staged": {
    "*.{ts,mts}": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
